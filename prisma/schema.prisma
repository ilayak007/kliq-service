generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id                  String           @id @default(uuid())
  name                String
  description         String
  budget              Int
  launchDate          DateTime
  assignedBy          String
  assignedChannels    String[]
  imageKey            String?
  assignedImageKey    String?
  campaignCreatedDate DateTime         @default(now())
  invitedCreators     InvitedCreator[]
}

model Creator {
  id               String           @id @default(uuid())
  name             String
  followers        Int
  platforms        String[]
  city             String
  country          String
  imageKey         String?
  invitedCampaigns InvitedCreator[]
}

model InvitedCreator {
  id         String   @id @default(uuid())
  campaignId String
  creatorId  String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorId])
}

model Tournament {
  tournamentId   String    @id @default(uuid())
  tournamentName String
  sport          String
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean   @default(true)
  description    String?
  imageKey       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  matches        Matches[]

  @@map("tournaments")
}

model CustomerPrediction {
  predictionId     Int      @id @default(autoincrement())
  matchId          Int
  customerId       Int
  customerName     String
  customerSelected String
  result           Result?
  pointsEarned     Int?
  isPointsUpdated  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  match            Matches  @relation(fields: [matchId], references: [matchId])

  @@index([matchId, customerId])
}

model Customers {
  customerId     Int       @id @default(autoincrement())
  customerName   String
  profileImage   String
  email          String    @unique
  password       String
  lastLoggedIn   DateTime?
  profileMessage String?
}

model Matches {
  teamA               String
  teamB               String
  matchStartDateTime  DateTime
  result              String?
  matchLocation       String?
  isActive            Boolean              @default(false)
  isDrawNeeded        Boolean              @default(false)
  matchId             Int                  @id
  tournamentId        String
  customerPredictions CustomerPrediction[]
  tournament          Tournament           @relation(fields: [tournamentId], references: [tournamentId])

  @@map("Matches")
  @@index([tournamentId])
}

enum Result {
  WON
  LOST
}
